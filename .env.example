# Copy this file to .env and put your key there. Never commit .env.

# Provider: gemini (default), openai (any OpenAI-compatible API) or ollama (local model)
LLM_PROVIDER=gemini

# Google Gemini API, free key: https://aistudio.google.com/ -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is overloaded (503) or out of daily quota
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# OpenAI-compatible provider (OpenAI, OpenRouter, vLLM)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# Local model through Ollama: the document never leaves the computer
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Sampling temperature (0 = most repeatable)
LLM_TEMPERATURE=0
